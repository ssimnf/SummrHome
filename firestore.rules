rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwnerRole() {
      return isVerified()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    function isBoundedString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidUserPublicProfile(data, userId) {
      return data.keys().hasAll(['uid', 'name', 'role', 'city', 'neighborhood', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'name', 'role', 'gender', 'collegeOrOrg', 'city', 'neighborhood', 'photo', 'linkedStudentName', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && isBoundedString(data.name, 1, 100)
        && data.role in ['student', 'owner', 'guardian']
        && (!('gender' in data) || data.gender in ['Male', 'Female'])
        && (data.role != 'student' || ('gender' in data && data.gender in ['Male', 'Female']))
        && (!('collegeOrOrg' in data) || isBoundedString(data.collegeOrOrg, 0, 150))
        && isBoundedString(data.city, 1, 80)
        && isBoundedString(data.neighborhood, 1, 100)
        && (!('photo' in data) || isBoundedString(data.photo, 0, 200000))
        && (!('linkedStudentName' in data) || isBoundedString(data.linkedStudentName, 0, 100))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'mobile', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'mobile', 'linkedGuardianName', 'linkedGuardianMobile', 'roommateRequests', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && isBoundedString(data.email, 0, 150)
        && isBoundedString(data.mobile, 0, 25)
        && (!('linkedGuardianName' in data) || isBoundedString(data.linkedGuardianName, 0, 100))
        && (!('linkedGuardianMobile' in data) || isBoundedString(data.linkedGuardianMobile, 0, 25))
        && (!('roommateRequests' in data) || (data.roommateRequests is list && data.roommateRequests.size() <= 50 && (data.roommateRequests.size() == 0 || data.roommateRequests[0] is string)))
        && data.updatedAt is timestamp;
    }

    function isValidPGListing(data, pgId) {
      return data.keys().hasAll([
          'id', 'ownerUid', 'ownerName', 'title', 'city', 'neighborhood', 'nearCollege',
          'gender', 'sharingOptions', 'acAvailable', 'foodIncluded', 'weeklyMenu',
          'amenities', 'photos', 'rules', 'description', 'verified', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerUid', 'ownerName', 'businessContact', 'title', 'city', 'district',
          'neighborhood', 'nearCollege', 'distanceText', 'gender', 'sharingOptions',
          'acAvailable', 'foodIncluded', 'mealType', 'weeklyMenu', 'amenities', 'photos',
          'rules', 'description', 'verified', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == pgId
        && isValidId(data.ownerUid)
        && isBoundedString(data.ownerName, 1, 100)
        && (!('businessContact' in data) || isBoundedString(data.businessContact, 0, 25))
        && isBoundedString(data.title, 1, 140)
        && isBoundedString(data.city, 1, 80)
        && (!('district' in data) || isBoundedString(data.district, 0, 80))
        && isBoundedString(data.neighborhood, 1, 100)
        && isBoundedString(data.nearCollege, 1, 150)
        && (!('distanceText' in data) || isBoundedString(data.distanceText, 0, 60))
        && data.gender in ['Boys', 'Girls', 'Co-ed']
        && data.sharingOptions is list && data.sharingOptions.size() >= 1 && data.sharingOptions.size() <= 5 && data.sharingOptions[0] is map
        && data.acAvailable is bool
        && data.foodIncluded is bool
        && (!('mealType' in data) || isBoundedString(data.mealType, 0, 60))
        && data.weeklyMenu is list && data.weeklyMenu.size() <= 7 && (data.weeklyMenu.size() == 0 || data.weeklyMenu[0] is map)
        && data.amenities is list && data.amenities.size() <= 15 && (data.amenities.size() == 0 || data.amenities[0] is string)
        && data.photos is list && data.photos.size() <= 6 && (data.photos.size() == 0 || data.photos[0] is string)
        && data.rules is list && data.rules.size() <= 10 && (data.rules.size() == 0 || data.rules[0] is string)
        && isBoundedString(data.description, 1, 1000)
        && data.verified is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBooking(data, bookingId) {
      return data.keys().hasAll([
          'id', 'pgId', 'pgTitle', 'ownerUid', 'studentUid', 'studentName',
          'sharingType', 'moveInDate', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'pgId', 'pgTitle', 'ownerUid', 'studentUid', 'studentName',
          'studentMobile', 'guardianName', 'guardianMobile', 'sharingType',
          'moveInDate', 'note', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == bookingId
        && isValidId(data.pgId)
        && isBoundedString(data.pgTitle, 1, 140)
        && isValidId(data.ownerUid)
        && isValidId(data.studentUid)
        && isBoundedString(data.studentName, 1, 100)
        && (!('studentMobile' in data) || isBoundedString(data.studentMobile, 0, 25))
        && (!('guardianName' in data) || isBoundedString(data.guardianName, 0, 100))
        && (!('guardianMobile' in data) || isBoundedString(data.guardianMobile, 0, 25))
        && data.sharingType in ['Single', 'Double', 'Triple']
        && isBoundedString(data.moveInDate, 1, 20)
        && (!('note' in data) || isBoundedString(data.note, 0, 500))
        && data.status in ['Pending', 'Approved', 'Declined']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBazaarItem(data, itemId) {
      return data.keys().hasAll([
          'id', 'sellerUid', 'sellerName', 'showPhone', 'title', 'category',
          'price', 'condition', 'city', 'neighborhood', 'description',
          'photos', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'sellerUid', 'sellerName', 'contactNumber', 'showPhone', 'title',
          'category', 'price', 'condition', 'city', 'neighborhood', 'description',
          'photos', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == itemId
        && isValidId(data.sellerUid)
        && isBoundedString(data.sellerName, 1, 100)
        && data.showPhone is bool
        && (!('contactNumber' in data) || (data.showPhone ? isBoundedString(data.contactNumber, 0, 25) : data.contactNumber == ''))
        && isBoundedString(data.title, 1, 140)
        && isBoundedString(data.category, 1, 60)
        && data.price is number && data.price >= 0 && data.price <= 500000
        && isBoundedString(data.condition, 1, 40)
        && isBoundedString(data.city, 1, 80)
        && isBoundedString(data.neighborhood, 1, 100)
        && isBoundedString(data.description, 1, 1000)
        && data.photos is list && data.photos.size() <= 5 && (data.photos.size() == 0 || data.photos[0] is string)
        && data.status in ['Available', 'Sold']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRoommateProfile(data, profileId) {
      return data.keys().hasAll([
          'id', 'studentUid', 'name', 'gender', 'college', 'city', 'neighborhood',
          'targetPG', 'sharing', 'budget', 'sleepSchedule', 'foodHabit',
          'studyStyle', 'bio', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'studentUid', 'name', 'gender', 'college', 'year', 'city',
          'neighborhood', 'targetPG', 'sharing', 'budget', 'sleepSchedule',
          'foodHabit', 'studyStyle', 'bio', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == profileId
        && isValidId(data.studentUid)
        && isBoundedString(data.name, 1, 100)
        && data.gender in ['Male', 'Female']
        && isBoundedString(data.college, 1, 150)
        && (!('year' in data) || isBoundedString(data.year, 0, 40))
        && isBoundedString(data.city, 1, 80)
        && isBoundedString(data.neighborhood, 1, 100)
        && isBoundedString(data.targetPG, 1, 140)
        && isBoundedString(data.sharing, 1, 40)
        && data.budget is number && data.budget >= 0 && data.budget <= 100000
        && isBoundedString(data.sleepSchedule, 1, 40)
        && isBoundedString(data.foodHabit, 1, 40)
        && isBoundedString(data.studyStyle, 1, 40)
        && isBoundedString(data.bio, 1, 500)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGuardianAlert(data, alertId) {
      return data.keys().hasAll([
          'id', 'studentUid', 'guardianUid', 'studentName', 'pgTitle', 'type',
          'message', 'locationNote', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'studentUid', 'guardianUid', 'studentName', 'pgTitle', 'type',
          'message', 'locationNote', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == alertId
        && isValidId(data.studentUid)
        && isValidId(data.guardianUid)
        && isBoundedString(data.studentName, 1, 100)
        && isBoundedString(data.pgTitle, 1, 140)
        && isBoundedString(data.type, 1, 60)
        && isBoundedString(data.message, 1, 500)
        && isBoundedString(data.locationNote, 1, 150)
        && data.status in ['Pending Approval', 'Approved', 'Acknowledged']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChatMessage(data, messageId) {
      return data.keys().hasAll([
          'id', 'threadId', 'senderUid', 'senderName', 'senderRole', 'text', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'threadId', 'senderUid', 'senderName', 'senderRole', 'text', 'timestampLabel', 'createdAt'
        ])
        && isValidId(data.id)
        && data.id == messageId
        && isValidId(data.threadId)
        && isValidId(data.senderUid)
        && data.senderUid == request.auth.uid
        && isBoundedString(data.senderName, 1, 120)
        && data.senderRole in ['student', 'owner', 'guardian']
        && isBoundedString(data.text, 1, 1000)
        && (!('timestampLabel' in data) || isBoundedString(data.timestampLabel, 0, 30))
        && data.createdAt is timestamp;
    }

    function isValidNotification(data, notificationId) {
      return data.keys().hasAll([
          'id', 'recipientUid', 'senderUid', 'type', 'title', 'message',
          'targetTab', 'read', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'recipientUid', 'senderUid', 'type', 'title', 'message',
          'targetTab', 'read', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == notificationId
        && isValidId(data.recipientUid)
        && isValidId(data.senderUid)
        && data.type in ['booking', 'bazaar', 'roomie', 'guardian', 'system']
        && isBoundedString(data.title, 1, 140)
        && isBoundedString(data.message, 1, 500)
        && data.targetTab in ['pg', 'bazaar', 'roomies', 'dashboard']
        && data.read is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isVerified() && isValidId(userId);
      allow list: if false;
      allow create: if isVerified()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserPublicProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserPublicProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().role == existing().role
        && (!('gender' in existing()) || incoming().gender == existing().gender)
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'collegeOrOrg', 'city', 'neighborhood', 'photo', 'linkedStudentName', 'updatedAt']);
      allow delete: if false;

      match /private/{docId} {
        allow get: if isVerified() && isValidId(userId) && isValidId(docId) && request.auth.uid == userId;
        allow list: if isVerified() && request.auth.uid == userId;
        allow create: if isVerified()
          && isValidId(userId)
          && docId == 'info'
          && request.auth.uid == userId
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().updatedAt == request.time;
        allow update: if isVerified()
          && isValidId(userId)
          && docId == 'info'
          && request.auth.uid == userId
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'mobile', 'linkedGuardianName', 'linkedGuardianMobile', 'roommateRequests', 'updatedAt']);
        allow delete: if false;
      }
    }

    match /pgListings/{pgId} {
      allow get: if isVerified() && isValidId(pgId);
      allow list: if isVerified() && resource.data.verified is bool;
      allow create: if isVerified()
        && isValidId(pgId)
        && isValidPGListing(incoming(), pgId)
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isOwnerRole();
      allow update: if isVerified()
        && isValidId(pgId)
        && isValidPGListing(incoming(), pgId)
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && isOwnerRole()
        && existing().ownerUid == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['sharingOptions', 'weeklyMenu', 'description', 'acAvailable', 'foodIncluded', 'updatedAt']);
      allow delete: if false;
    }

    match /bookings/{bookingId} {
      allow get: if isVerified() && isValidId(bookingId)
        && (resource.data.studentUid == request.auth.uid || resource.data.ownerUid == request.auth.uid);
      allow list: if isVerified()
        && (resource.data.studentUid == request.auth.uid || resource.data.ownerUid == request.auth.uid);
      allow create: if isVerified()
        && isValidId(bookingId)
        && isValidBooking(incoming(), bookingId)
        && incoming().studentUid == request.auth.uid
        && incoming().status == 'Pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (!exists(/databases/$(database)/documents/pgListings/$(incoming().pgId)) || get(/databases/$(database)/documents/pgListings/$(incoming().pgId)).data.ownerUid == incoming().ownerUid);
      allow update: if isVerified()
        && isValidId(bookingId)
        && isValidBooking(incoming(), bookingId)
        && incoming().id == existing().id
        && incoming().pgId == existing().pgId
        && incoming().ownerUid == existing().ownerUid
        && incoming().studentUid == existing().studentUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && existing().status == 'Pending'
        && existing().ownerUid == request.auth.uid
        && incoming().status in ['Approved', 'Declined']
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if false;
    }

    match /bazaarItems/{itemId} {
      allow get: if isVerified() && isValidId(itemId);
      allow list: if isVerified() && resource.data.status in ['Available', 'Sold'];
      allow create: if isVerified()
        && isValidId(itemId)
        && isValidBazaarItem(incoming(), itemId)
        && incoming().sellerUid == request.auth.uid
        && incoming().status == 'Available'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(itemId)
        && isValidBazaarItem(incoming(), itemId)
        && incoming().id == existing().id
        && incoming().sellerUid == existing().sellerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && existing().sellerUid == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if false;
    }

    match /roommates/{profileId} {
      allow get: if isVerified() && isValidId(profileId);
      allow list: if isVerified() && resource.data.gender in ['Male', 'Female'];
      allow create: if isVerified()
        && isValidId(profileId)
        && isValidRoommateProfile(incoming(), profileId)
        && incoming().studentUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(profileId)
        && isValidRoommateProfile(incoming(), profileId)
        && incoming().id == existing().id
        && incoming().studentUid == existing().studentUid
        && incoming().gender == existing().gender
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && existing().studentUid == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['targetPG', 'sharing', 'budget', 'bio', 'updatedAt']);
      allow delete: if false;
    }

    match /guardianAlerts/{alertId} {
      allow get: if isVerified() && isValidId(alertId)
        && (resource.data.studentUid == request.auth.uid || resource.data.guardianUid == request.auth.uid);
      allow list: if isVerified()
        && (resource.data.studentUid == request.auth.uid || resource.data.guardianUid == request.auth.uid);
      allow create: if isVerified()
        && isValidId(alertId)
        && isValidGuardianAlert(incoming(), alertId)
        && incoming().studentUid == request.auth.uid
        && incoming().status == 'Pending Approval'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(alertId)
        && isValidGuardianAlert(incoming(), alertId)
        && incoming().id == existing().id
        && incoming().studentUid == existing().studentUid
        && incoming().guardianUid == existing().guardianUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && existing().status == 'Pending Approval'
        && existing().guardianUid == request.auth.uid
        && incoming().status in ['Approved', 'Acknowledged']
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if false;
    }

    match /chatMessages/{messageId} {
      allow get: if isVerified() && isValidId(messageId);
      allow list: if isVerified() && resource.data.senderUid is string;
      allow create: if isVerified()
        && isValidId(messageId)
        && isValidChatMessage(incoming(), messageId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow get: if isVerified() && isValidId(notificationId) && resource.data.recipientUid == request.auth.uid;
      allow list: if isVerified() && resource.data.recipientUid == request.auth.uid;
      allow create: if isVerified()
        && isValidId(notificationId)
        && isValidNotification(incoming(), notificationId)
        && incoming().senderUid == request.auth.uid
        && incoming().read == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(notificationId)
        && isValidNotification(incoming(), notificationId)
        && incoming().id == existing().id
        && incoming().recipientUid == existing().recipientUid
        && incoming().senderUid == existing().senderUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && existing().recipientUid == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt']);
      allow delete: if isVerified() && isValidId(notificationId) && resource.data.recipientUid == request.auth.uid;
    }
  }
}
