{
  "entities": {
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Non-PII public profile and immutable role/gender identity for a SummrHome user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the user."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Display name."
        },
        "role": {
          "type": "string",
          "enum": ["student", "owner", "guardian"],
          "description": "Account role locked after registration."
        },
        "gender": {
          "type": "string",
          "enum": ["Male", "Female"],
          "description": "Student gender locked after registration."
        },
        "collegeOrOrg": {
          "type": "string",
          "maxLength": 150,
          "description": "College name, PG property name, or linked ward."
        },
        "city": {
          "type": "string",
          "maxLength": 80,
          "description": "Active town or city."
        },
        "neighborhood": {
          "type": "string",
          "maxLength": 100,
          "description": "Active neighborhood or para."
        },
        "photo": {
          "type": "string",
          "maxLength": 200000,
          "description": "Optional compressed profile avatar URL or data URI."
        },
        "linkedStudentName": {
          "type": "string",
          "maxLength": 100,
          "description": "Linked ward name for guardian accounts."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "name", "role", "city", "neighborhood", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Strictly isolated PII and personal preferences for a user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 150
        },
        "mobile": {
          "type": "string",
          "maxLength": 25
        },
        "linkedGuardianName": {
          "type": "string",
          "maxLength": 100
        },
        "linkedGuardianMobile": {
          "type": "string",
          "maxLength": 25
        },
        "roommateRequests": {
          "type": "array",
          "description": "List of roommate profile IDs the student has teamed up with (max 50)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "mobile", "updatedAt"]
    },
