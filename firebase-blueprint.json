  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "Public profile with locked role and gender."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Private PII (email, mobile, guardian info, roommate requests) accessible only by owner."
    },
    "/pgListings/{pgId}": {
      "schema": { "$ref": "#/entities/PGListing" },
      "description": "PG listings created and managed by PG owners."
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Student bed booking requests scoped to studentUid and ownerUid."
    },
    "/bazaarItems/{itemId}": {
      "schema": { "$ref": "#/entities/BazaarItem" },
      "description": "Student Bazaar classifieds."
    },
    "/roommates/{profileId}": {
      "schema": { "$ref": "#/entities/RoommateProfile" },
      "description": "Roommate compatibility cards."
    },
    "/guardianAlerts/{alertId}": {
      "schema": { "$ref": "#/entities/GuardianAlert" },
      "description": "Night-out and check-in alerts scoped to studentUid and guardianUid."
    },
    "/chatMessages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Chat messages for Bazaar and Guardian-Owner threads."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Real-time notifications scoped strictly to recipientUid."
    }
  }
}
