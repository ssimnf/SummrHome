        "foodIncluded": {
          "type": "boolean"
        },
        "mealType": {
          "type": "string",
          "maxLength": 60
        },
        "weeklyMenu": {
          "type": "array"
        },
        "amenities": {
          "type": "array"
        },
        "photos": {
          "type": "array"
        },
        "rules": {
          "type": "array"
        },
        "description": {
